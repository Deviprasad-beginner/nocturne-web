# ─── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
# Get yours at https://neon.tech → project → Connection Details → Pooled connection
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: override the SNI hostname for Neon if you hit certificate errors
# DB_SNI_SERVERNAME=your-neon-hostname.neon.tech

# ─── Session ──────────────────────────────────────────────────────────────────
# Any long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string_at_least_64_chars

# ─── Firebase Admin (server-side) ─────────────────────────────────────────────
# Paste the entire service account JSON as a single-line string (escape newlines as \n)
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"..."}

# Alternative: path to the service account JSON file (not recommended for production)
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ─── Firebase Client (browser-side, safe to expose) ───────────────────────────
# Get from Firebase Console → Project Settings → Your apps → Web app → Config
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:...

# ─── AI (optional) ────────────────────────────────────────────────────────────
# Required only if using Nightly Reflection / AI features
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Required in production — set to your deployed frontend URL (no trailing slash)
# FRONTEND_URL=https://your-app.vercel.app
